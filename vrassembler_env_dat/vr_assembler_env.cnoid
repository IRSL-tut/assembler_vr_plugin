items: 
  id: 0
  name: "RootItem"
  plugin: Base
  class: RootItem
  is_builtin_item: true
  children: 
    - 
      id: 1
      name: "rightHand"
      plugin: Base
      class: SceneItem
      is_selected: true
      is_checked: true
      data: 
        file: "C:/Users/irsl/VR/right_cont_test.stl"
        format: GENERAL-3D-MODEL
        meshLengthUnitHint: inch
        translation: [ 0, 0, 0 ]
        rotation: [ 1, 0, 0, 0 ]
        angle_unit: degree
        lightweight_rendering: false
    - 
      id: 2
      name: "leftHand"
      plugin: Base
      class: SceneItem
      is_selected: true
      is_checked: true
      data: 
        file: "C:/Users/irsl/VR/left_cont_test.stl"
        format: GENERAL-3D-MODEL
        meshLengthUnitHint: inch
        translation: [ 0, 0, 0 ]
        rotation: [ 1, 0, 0, 0 ]
        angle_unit: degree
        lightweight_rendering: false
    - 
      id: 3
      name: "Table"
      plugin: Body
      class: BodyItem
      is_checked: true
      data: 
        file: "C:/Users/irsl/VR/dining_table.body"
        format: CHOREONOID-BODY
        rootPosition: [ 0.7, 0, 0 ]
        rootAttitude: [ 
          1, 0, 0, 
          0, 1, 0, 
          0, 0, 1 ]
        jointPositions: [  ]
        initialRootPosition: [ -2.5, 0, 0 ]
        initialRootAttitude: [ 
          1, 0, 0, 
          0, 1, 0, 
          0, 0, 1 ]
        fix_root: true
        collisionDetection: true
        selfCollisionDetection: false
        lock_location: false
        scene_sensitive: true
        zmp: [ 0, 0, 0 ]
    - 
      id: 4
      name: "DepotWorld"
      plugin: Body
      class: WorldItem
      is_checked: true
      data: 
        collision_detection: false
